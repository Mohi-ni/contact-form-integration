# Server
PORT=5000

# Frontend URL(s), comma separated if needed
CORS_ORIGIN=http://localhost:5000

# SMTP settings - use your company's SMTP provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Company mailbox that receives contact enquiries
COMPANY_EMAIL=company@example.com

# Simple protection for the optional admin dashboard
ADMIN_TOKEN=change-this-to-a-long-random-token

# Optional: if true, the API sends the acknowledgement email to the visitor
SEND_AUTO_REPLY=true